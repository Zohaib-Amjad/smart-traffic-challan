{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/frontend/$1" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/vehicles", "destination": "/frontend/vehicles.html" },
    { "source": "/vehicles/add", "destination": "/frontend/vehicles.html" },
    { "source": "/challans", "destination": "/frontend/challans.html" },
    { "source": "/challan/(.*)", "destination": "/frontend/challan_detail.html" },
    { "source": "/generate-challan", "destination": "/frontend/generate_challan.html" },
    { "source": "/generate_challan", "destination": "/frontend/generate_challan.html" },
    { "source": "/reports", "destination": "/frontend/reports.html" },
    { "source": "/number-plate", "destination": "/frontend/number_plate.html" },
    { "source": "/number_plate", "destination": "/frontend/number_plate.html" },
    { "source": "/traffic-rules", "destination": "/frontend/traffic-rules.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/register", "destination": "/frontend/register.html" },
    { "source": "/citizen", "destination": "/frontend/number_plate.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
